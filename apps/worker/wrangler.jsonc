// Worker config. Top level = dev environment; `env.production` = prod.
// Deployed only by GitHub Actions (docs/setup.md). Built through apps/web's Vite
// config, which bundles the web app as static assets.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "assistant-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // The old *.workers.dev address stays on so existing calendar links and shortcuts keep
  // working; the web app sends browsers from it to the domain (apps/web/src/core/domain.ts).
  "workers_dev": true,
  // Custom domain (decision 2026-09-29): Cloudflare makes the DNS record on deploy.
  "routes": [{ "pattern": "dev.gigspree.in", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // These paths always reach the Worker, never the static files.
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/.well-known/*"],
  },
  // Database ids aren't secret; the deploy workflow fills them in (docs/setup.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assistant-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Gig-centric storage (docs/design/gig-centric.md): one small SQLite database per gig,
  // per person, per month index, plus a few pending-list shards.
  "durable_objects": {
    "bindings": [
      { "name": "BOOKINGS", "class_name": "BookingObject" },
      { "name": "PEOPLE", "class_name": "PersonObject" },
      { "name": "MONTHS", "class_name": "MonthIndexObject" },
      { "name": "PENDING", "class_name": "PendingObject" },
      { "name": "INBOX", "class_name": "InboxObject" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BookingObject", "PersonObject", "MonthIndexObject", "PendingObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["InboxObject"],
    },
  ],
  // Outbox notes travel here; the deploy workflow creates the queues if missing.
  "queues": {
    "producers": [{ "binding": "SUMMARIES", "queue": "summaries-dev" }],
    "consumers": [
      {
        "queue": "summaries-dev",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "summaries-dev-dlq",
      },
      // Failed-every-retry messages: recorded for alerts and the retry tool.
      { "queue": "summaries-dev-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
    ],
  },
  // Per-action counts, errors and timings for the admin panel (ids and numbers only).
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "assistant_dev_metrics" }],
  // Health checks and alerts every 15 minutes, plus nightly jobs (core/scheduled.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "dev",
    "BASE_URL": "https://dev.gigspree.in",
  },
  "env": {
    "production": {
      "name": "assistant",
      "routes": [
        { "pattern": "gigspree.in", "custom_domain": true },
        { "pattern": "www.gigspree.in", "custom_domain": true },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "assistant",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      // Gig-centric storage (docs/design/gig-centric.md): one small SQLite database per gig,
      // per person, per month index, plus a few pending-list shards.
      "durable_objects": {
        "bindings": [
          { "name": "BOOKINGS", "class_name": "BookingObject" },
          { "name": "PEOPLE", "class_name": "PersonObject" },
          { "name": "MONTHS", "class_name": "MonthIndexObject" },
          { "name": "PENDING", "class_name": "PendingObject" },
          { "name": "INBOX", "class_name": "InboxObject" },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BookingObject", "PersonObject", "MonthIndexObject", "PendingObject"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["InboxObject"],
        },
      ],
      // Outbox notes travel here; the deploy workflow creates the queues if missing.
      "queues": {
        "producers": [{ "binding": "SUMMARIES", "queue": "summaries" }],
        "consumers": [
          {
            "queue": "summaries",
            "max_batch_size": 100,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "dead_letter_queue": "summaries-dlq",
          },
          { "queue": "summaries-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
        ],
      },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "assistant_metrics" }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_URL": "https://gigspree.in",
      },
    },
  },
}
