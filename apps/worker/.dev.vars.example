# Copy to .dev.vars for `pnpm dev`. Placeholders only; never commit .dev.vars.
ENVIRONMENT=development
BASE_URL=http://localhost:8787
# Any long random string for local sessions (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=local-dev-only-change-me
# Optional locally: without real values, sign in with email/password (localhost only).
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder
# Admin panel owners (comma-separated emails). In prod/dev this is a GitHub secret.
ADMIN_EMAILS=admin@example.com

# Optional: per-action numbers in the admin panel (Analytics Engine SQL API).
# A Cloudflare API token with only "Account Analytics: Read", and the account id.
ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: alerts to the owner's Telegram bot (token from @BotFather). Never commit it.
TELEGRAM_BOT_TOKEN=

# Optional: the Apple developer Team ID, so passkeys work in the iPhone app
# (/.well-known/apple-app-site-association). Not secret, but set like the others.
APPLE_TEAM_ID=

# The in-app assistant uses a scripted model locally (no Workers AI, no cost).
AI_FAKE=1

# Optional: faster answers from Cerebras (cloud.cerebras.ai → API Keys). In prod/dev this is
# the GitHub secret CEREBRAS_API_KEY. Never commit it.
CEREBRAS_API_KEY=

# Optional: Claude models from Anthropic (platform.claude.com → API keys), on prepaid credit
# there. In prod/dev this is the GitHub secret ANTHROPIC_API_KEY. Never commit it.
ANTHROPIC_API_KEY=
# Optional: OpenAI (platform.openai.com → API keys) and Google (aistudio.google.com → Get API
# key), the same way: GitHub secrets OPENAI_API_KEY and GEMINI_API_KEY. Never commit them.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Jev, TypeSafe AI's decision model (typesafe.ai → API keys), for the app's own picks
# (a flow's Choose step, suggested actions); owners only for now. In prod/dev this is the GitHub
# secret TYPESAFE_API_KEY. Never commit it. JEV_MODEL (a wrangler var) pins a version; the
# default is jev-latest.
TYPESAFE_API_KEY=

# Optional: encrypts the nightly backup (any long random string, e.g. `openssl rand -base64 32`).
# Keep it in your password manager: a restore needs the same key. Without it, backups are
# gzipped JSON in your private Drive.
BACKUP_KEY=
