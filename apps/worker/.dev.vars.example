# Copy to .dev.vars for `pnpm dev`. Placeholders only; never commit .dev.vars.
ENVIRONMENT=development
BASE_URL=http://localhost:8787
# Any long random string for local sessions (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=local-dev-only-change-me
# Optional locally: without real values, sign in with email/password (localhost only).
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder
